# Local GPU-backed Qwen configuration for the Docker Compose ollama profile.
# This file contains no API key. Copy it to .env before running the profile.
TRADINGAGENTS_LLM_PROVIDER=ollama
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:14b
TRADINGAGENTS_DEEP_THINK_LLM=qwen3:14b
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# Optional Alpaca paper-account credentials for the combined, deduplicated
# Alpaca + Yahoo ticker-news feed. Leave empty to use Yahoo only.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
