# Local GPU-backed Qwen configuration for the Docker Compose ollama profile.
# This file contains no API key. Copy it to .env before running the profile.
TRADINGAGENTS_LLM_PROVIDER=ollama
TRADINGAGENTS_QUICK_THINK_LLM=qwen3:14b
TRADINGAGENTS_DEEP_THINK_LLM=qwen3:14b
TRADINGAGENTS_OUTPUT_LANGUAGE=English
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1

# No Alpaca credentials belong on ai-node: Alpaca news is read through thinkpad-prod's
# private research gateway (see OPENBB_RESEARCH_URL in docker-compose.yml).

# Private runner API. Keep the token file outside Git and bind only to
# ai-node's Tailscale IP; the defaults remain localhost-only and fail closed
# when the token file is absent.
TRADINGAGENTS_RUNNER_BIND_IP=127.0.0.1
TRADINGAGENTS_RUNNER_TOKEN_FILE=./runner_api_token.txt
